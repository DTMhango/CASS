.env
.env.*
!.env.example
!.env.*.example
platform/.artifacts/
platform/**/db.sqlite3
platform/**/staticfiles/

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/

# Backend local state
platform/backend/.venv/
platform/backend/.test-artifacts/

# Generated deployment records
platform/deploy/image-digests.txt
platform/model_data/

# Confidential portfolio extracts. Commit only masked/synthetic structural fixtures.
premium_policies_2026-06-30_geocoded.xlsx
