# CASS environment for a Dokploy deployment on a shared server.
#
# In Dokploy, create a Docker Compose service from this repository with the
# compose path
#
#   platform/deploy/docker-compose.yml
#
# paste this file into its Environment tab, and fill in the blanks. Leave
# Advanced -> Command as Dokploy's default: nothing below needs a custom one.
#
# It follows .env.example. Four settings are what Dokploy itself needs, each
# marked "Dokploy:" below: Dokploy runs compose from the repository root rather
# than beside the compose file, with no --profile, and clones the repository
# afresh on every deploy -- so the paths, the engines and the model data are set
# here rather than assumed. The browser origins must also name the server's
# address. Every setting .env.example has is here too; a test keeps the two in
# step.
#
# Nothing in this file is a secret until you fill it in. Dokploy stores what you
# paste; do not commit a filled-in copy.

# -- required secrets -------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CASS_SECRET_KEY=
POSTGRES_PASSWORD=
OASIS_ADMIN_PASS=

# -- control plane ----------------------------------------------------------
# cass.settings.prod is the hardened module, and it requires HTTPS end to end:
# it sets secure-only cookies, redirects HTTP and sends HSTS for a year, which a
# browser keeps even after the setting changes. Move to it, with CASS_DEBUG
# false, once the Dokploy domain serves HTTPS. Until then this runs as a
# workstation does -- and with CASS_DEBUG true an error page shows its
# traceback, so keep the installation to the people it is for.
DJANGO_SETTINGS_MODULE=cass.settings.dev
CASS_DEBUG=true
CASS_ALLOWED_HOSTS=localhost,127.0.0.1,api
CASS_LOG_LEVEL=INFO

POSTGRES_DB=cass
POSTGRES_USER=cass

# -- artifact storage -------------------------------------------------------
# `s3` uses the bundled MinIO. `filesystem` is the fallback for a constrained
# local installation; the object interface is the same either way.
CASS_ARTIFACT_BACKEND=s3
MINIO_ROOT_USER=cass-local
MINIO_ROOT_PASSWORD=

# -- uploads ----------------------------------------------------------------
# Direct uploads go straight to the store and are registered only once read
# back, checksummed and scanned. A session not completed in this many seconds is
# expired by the nightly retention sweep.
CASS_MAX_UPLOAD_BYTES=536870912
CASS_UPLOAD_SESSION_SECONDS=900

# -- grids and hazard -----------------------------------------------------------
# The largest grid a specification may build, in cells. Every cell is a site in
# every hazard calculation on the grid, so raising this raises hazard time and
# storage; the grid builder's estimate shows both before anything is built.
CASS_MAX_GRID_CELLS=500000
# Whether OpenQuake keeps its own copy of a calculation after CASS has stored its
# datastore. false stores each calculation once; a comparison against OpenQuake
# then runs the calculation again and checks it reproduces the stored motion.
CASS_OPENQUAKE_KEEP_CALCULATIONS=false
# An antivirus engine speaking clamd's protocol. Leave the host empty where
# there is none: uploads are still content-checked, and each one records that
# no antivirus scan was made rather than implying one.
CASS_CLAMD_HOST=
CASS_CLAMD_PORT=3310

# -- observability ----------------------------------------------------------
# The bearer token a Prometheus scraper presents at /metrics/. Empty means only
# a platform administrator's session may read the metrics. A secret: generate
# it the same way as the others.
CASS_METRICS_TOKEN=

# -- ports ------------------------------------------------------------------
# Published on the server itself, so on a shared host each must be free of the
# other applications' ports. With a Dokploy domain on the frontend service, port
# 8080 inside it, nobody needs to reach these directly. The MinIO console sits
# behind the MinIO root credentials; keep its port off any network wider than
# the people who administer CASS.
CASS_API_PORT=8000
CASS_WEB_PORT=8080
MINIO_CONSOLE_PORT=9001

# -- browser origins --------------------------------------------------------
# The address people open CASS at: the Dokploy domain, with its scheme.
CASS_CORS_ORIGINS=https://cass.example.internal
CASS_CSRF_TRUSTED_ORIGINS=https://cass.example.internal
CASS_API_ORIGIN=http://api:8000

# -- capacity ---------------------------------------------------------------
# Section 11: declared limits, not inherited maximum parallelism. The PiWind
# baseline peaked near 21.6 GB under an all-output configuration, so raise
# these only against measured need.
CASS_WORKER_CONCURRENCY=2
CASS_DEFAULT_EXECUTION_PROFILE=standard

# -- resource limits --------------------------------------------------------
# The defaults are for this: a shared server where CASS may use about 24 GB.
# The long-running containers' limits add up to 22 GiB (23.6 GB), which is the
# ceiling, not a reservation. See .env.example for what each one covers.
#
# 0 lifts a limit; CASS_RESOURCE_LIMITS=0 lifts them all. Do not do either on a
# shared server without the memory to back it.
CASS_RESOURCE_LIMITS=

# Control plane.
# CASS_POSTGRES_MEMORY=768M
# CASS_REDIS_MEMORY=256M
# CASS_MINIO_MEMORY=768M
# CASS_API_MEMORY=1536M
# CASS_WORKER_MEMORY=3.5G
# CASS_BEAT_MEMORY=256M
# CASS_FRONTEND_MEMORY=256M

# Engines.
# CASS_OPENQUAKE_MEMORY=8G
# CASS_OASIS_API_MEMORY=1536M
# CASS_OASIS_CELERY_MEMORY=768M
# CASS_OASIS_WORKER_MEMORY=4.5G

# Processes the engines start; raise one only with its memory.
# CASS_OPENQUAKE_CORES=3
# CASS_OASIS_KERNEL_PROCESSES=4
# CASS_OASIS_API_WORKERS=3

# -- model data -------------------------------------------------------------
# The GEM release this installation builds vulnerability sets from, as the
# containers see it. Optional: the Build tab lists every release under the
# models folder and lets it be chosen there.
CASS_GEM_ROOT=

# Dokploy: an absolute path on the server. Dokploy deletes and re-clones the
# repository on every deploy, so the models live outside it -- and outside
# /etc/dokploy, which is Dokploy's own. The folder is mounted read-only, and
# the containers read it as uid 10001, so its files must be readable by that
# user (chmod -R a+rX is enough). Keep each GEM repository's .git folder: CASS
# reads the release it is at from there.
CASS_MODELS_PATH=/srv/cass/models

# -- engines ----------------------------------------------------------------
# Dokploy: Dokploy's compose command takes no --profile, so this starts the
# engines. Without it OpenQuake, Oasis, keys and the converter never start, and
# nothing reports it.
COMPOSE_PROFILES=engines

OASIS_ADMIN_USER=admin
OASIS_MODEL_SUPPLIER_ID=KRE
OASIS_MODEL_ID=EQ
OASIS_MODEL_VERSION_ID=1

# Dokploy: empty, so the Oasis worker serves the packages CASS builds, from the
# oasis-model volume. A host path here would replace them with that folder.
CASS_MODEL_DATA_PATH=

# -- where the platform is --------------------------------------------------
# Dokploy: it resolves compose's relative paths from the repository root, not
# from the compose file's folder, so the build contexts and the database
# initialisation scripts are found through this. The "./" matters -- without
# it compose reads the init scripts' path as the name of a volume.
CASS_PLATFORM_DIR=./platform
