# KRE platform environment template.
#
# Copy to platform/.env and fill in. Section 10 requires secrets to be kept out
# of source control and container images, so this file holds names and shapes,
# never values. The .env it produces is gitignored.
#
#   cd platform && cp deploy/.env.example .env

# -- required secrets -------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
KRE_SECRET_KEY=
POSTGRES_PASSWORD=
OASIS_ADMIN_PASS=

# -- control plane ----------------------------------------------------------
DJANGO_SETTINGS_MODULE=kre.settings.dev
KRE_DEBUG=true
KRE_ALLOWED_HOSTS=localhost,127.0.0.1,api
KRE_LOG_LEVEL=INFO

POSTGRES_DB=kre
POSTGRES_USER=kre

# -- artifact storage -------------------------------------------------------
# `s3` uses the bundled MinIO. `filesystem` is the fallback for a constrained
# local installation; the object interface is the same either way.
KRE_ARTIFACT_BACKEND=s3
MINIO_ROOT_USER=kre-local
MINIO_ROOT_PASSWORD=

# -- ports ------------------------------------------------------------------
KRE_API_PORT=8000
KRE_WEB_PORT=8080
MINIO_CONSOLE_PORT=9001

# -- browser origins --------------------------------------------------------
# The Vite dev server during development; the nginx origin once containerised.
KRE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
KRE_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
KRE_API_ORIGIN=http://api:8000

# -- capacity ---------------------------------------------------------------
# Section 11: declared limits, not inherited maximum parallelism. The PiWind
# baseline peaked near 21.6 GB under an all-output configuration, so raise
# these only against measured need.
KRE_WORKER_CONCURRENCY=2
KRE_DEFAULT_EXECUTION_PROFILE=standard
KRE_CONVERTER_MEMORY=16G

# -- engines ----------------------------------------------------------------
# Started only with the `engines` profile:
#   docker compose --profile engines up
OASIS_ADMIN_USER=admin
OASIS_MODEL_SUPPLIER_ID=KRE
OASIS_MODEL_ID=EQ
OASIS_MODEL_VERSION_ID=1

# Host path holding the Oasis model package the worker reads. Kept outside the
# repository: model packages are versioned release assets, not source.
KRE_MODEL_DATA_PATH=./model_data
