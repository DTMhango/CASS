# CASS platform environment template.
#
# Copy to platform/.env and fill in. Section 10 requires secrets to be kept out
# of source control and container images, so this file holds names and shapes,
# never values. The .env it produces is gitignored.
#
#   cd platform && cp deploy/.env.example .env

# -- required secrets -------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CASS_SECRET_KEY=
POSTGRES_PASSWORD=
OASIS_ADMIN_PASS=

# -- control plane ----------------------------------------------------------
DJANGO_SETTINGS_MODULE=cass.settings.dev
CASS_DEBUG=true
CASS_ALLOWED_HOSTS=localhost,127.0.0.1,api
CASS_LOG_LEVEL=INFO

POSTGRES_DB=cass
POSTGRES_USER=cass

# -- artifact storage -------------------------------------------------------
# `s3` uses the bundled MinIO. `filesystem` is the fallback for a constrained
# local installation; the object interface is the same either way.
CASS_ARTIFACT_BACKEND=s3
MINIO_ROOT_USER=cass-local
MINIO_ROOT_PASSWORD=

# -- uploads ----------------------------------------------------------------
# Direct uploads go straight to the store and are registered only once read
# back, checksummed and scanned. A session not completed in this many seconds is
# expired by the nightly retention sweep.
CASS_MAX_UPLOAD_BYTES=536870912
CASS_UPLOAD_SESSION_SECONDS=900

# -- grids and hazard -----------------------------------------------------------
# The largest grid a specification may build, in cells. Every cell is a site in
# every hazard calculation on the grid, so raising this raises hazard time and
# storage; the grid builder's estimate shows both before anything is built.
CASS_MAX_GRID_CELLS=500000
# Whether OpenQuake keeps its own copy of a calculation after CASS has stored its
# datastore. false stores each calculation once; a comparison against OpenQuake
# then runs the calculation again and checks it reproduces the stored motion.
CASS_OPENQUAKE_KEEP_CALCULATIONS=false
# An antivirus engine speaking clamd's protocol. Leave the host empty where
# there is none: uploads are still content-checked, and each one records that
# no antivirus scan was made rather than implying one.
CASS_CLAMD_HOST=
CASS_CLAMD_PORT=3310

# -- observability ----------------------------------------------------------
# The bearer token a Prometheus scraper presents at /metrics/. Empty means only
# a platform administrator's session may read the metrics. A secret: generate
# it the same way as the others.
CASS_METRICS_TOKEN=

# -- ports ------------------------------------------------------------------
CASS_API_PORT=8000
CASS_WEB_PORT=8080
MINIO_CONSOLE_PORT=9001

# -- browser origins --------------------------------------------------------
# The Vite dev server during development; the nginx origin once containerised.
CASS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CASS_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
CASS_API_ORIGIN=http://api:8000

# -- capacity ---------------------------------------------------------------
# Section 11: declared limits, not inherited maximum parallelism. The PiWind
# baseline peaked near 21.6 GB under an all-output configuration, so raise
# these only against measured need.
CASS_WORKER_CONCURRENCY=2
CASS_DEFAULT_EXECUTION_PROFILE=standard

# -- resource limits --------------------------------------------------------
# Memory limits per container, as Docker counts them: M and G are MiB and GiB.
# 0 is no limit. A setting left commented takes the default shown.
#
# The defaults fit a shared server where CASS may use about 24 GB: the
# long-running containers' limits add up to 22 GiB (23.6 GB). Docker has no
# limit across containers, so that sum is the ceiling, not a reservation --
# most containers idle far below theirs. A container that reaches its limit is
# stopped rather than moved onto swap, so a run that needs more fails with a
# reason instead of slowing every other application on the host.
#
# To lift every limit at once -- as CASS ran before these existed, and sensible
# on a machine it has to itself -- set this to 0. It stands in for each setting
# below that is left commented, process counts included. It is a per-container
# value, not a total, and 0 is the only value it is meant to take.
CASS_RESOURCE_LIMITS=

# Control plane. The API builds grids and vulnerability sets inside the request;
# the worker runs conversions, package builds and result collection.
# CASS_POSTGRES_MEMORY=768M
# CASS_REDIS_MEMORY=256M
# CASS_MINIO_MEMORY=768M
# CASS_API_MEMORY=1536M
# CASS_WORKER_MEMORY=3.5G
# CASS_BEAT_MEMORY=256M
# CASS_FRONTEND_MEMORY=256M

# Engines. OpenQuake runs hazard calculations; the Oasis worker runs losses.
# CASS_OPENQUAKE_MEMORY=8G
# CASS_OASIS_API_MEMORY=1536M
# CASS_OASIS_CELERY_MEMORY=768M
# CASS_OASIS_WORKER_MEMORY=4.5G

# Processes the engines start. Upstream, each starts one per CPU, and each
# process needs its own memory -- OpenQuake asks for at least 2 GB per core for
# hazard -- so on a server with many cores an engine outgrows any limit above
# unless these bound it. 0 restores the engine's own rule. Raise a count only
# with its memory: roughly 2 GB more per OpenQuake core, 1 GB per kernel process.
# CASS_OPENQUAKE_CORES=3
# CASS_OASIS_KERNEL_PROCESSES=4
# CASS_OASIS_API_WORKERS=3

# -- model data -------------------------------------------------------------
# The GEM release this installation builds vulnerability sets from, as the
# containers see it. Mount the release and point this at it; empty means no
# vulnerability set can be built here. The clones are large and licensed, so
# they live outside the repository and outside the images.
#
# Optional: the Build tab lists every GEM release under the models folder and
# lets it be chosen there, which is kept and wins over this setting. Leave it
# empty unless an installation should start with a release already chosen.
CASS_GEM_ROOT=

# The folder on your own device that holds the GEM clones (and any national
# hazard packages), mounted read-only into the containers at /models. Keep a
# GEM release as its two repositories side by side, for example
#   <models>/gem/v2026.0.0/global_exposure_model
#   <models>/gem/v2026.0.0/global_vulnerability_model
# cloned with git so CASS can read which release they are.
CASS_MODELS_PATH=../../models

# -- engines ----------------------------------------------------------------
# Started only with the `engines` profile -- `make up-engines`, or
# `docker compose --profile engines up`. Where the command cannot be changed,
# COMPOSE_PROFILES=engines in this file does the same.
OASIS_ADMIN_USER=admin
OASIS_MODEL_SUPPLIER_ID=KRE
OASIS_MODEL_ID=EQ
OASIS_MODEL_VERSION_ID=1

# The Oasis model root the worker reads, mounted at /home/worker/model. Leave it
# empty: the worker then serves the package CASS builds and deploys, from the
# oasis-model volume. Set a host path only to serve a model root from disk
# instead -- PiWind, for the live integration suite -- and it must then hold
# model_data/<Model>/, keys_data/<Model>/, meta-data/model_settings.json and
# oasislmf.json, the layout the model_worker image's conf.ini expects.
#
# This read ./model_data until the package volume replaced it, and a copy of
# that line hides every package CASS builds from the engine.
CASS_MODEL_DATA_PATH=

# -- where the platform is --------------------------------------------------
# Where platform/ is, from the folder compose resolves relative paths against.
# Under make that is docker-compose.yml's own folder, which the default suits.
# Only a deployment that points compose elsewhere sets this: Dokploy resolves
# from the repository root and uses ./platform (see dokploy.env.example).
# CASS_PLATFORM_DIR=..
