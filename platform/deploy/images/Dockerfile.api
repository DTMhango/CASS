# The CASS control plane and its workers.
#
# The API and the worker share one image: they run the same code and the same
# migrations, and a version skew between them would be a source of exactly the
# lineage problems section 5 is written to prevent.

FROM python:3.11.11-slim-bookworm@sha256:081075da77b2b55c23c088251026fb69a7b2bf92471e491ff5fd75c192fd38e5 AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# libpq for psycopg; curl for the healthcheck and support bundle.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies are installed before the source is copied, so a code change
# does not invalidate the dependency layer.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Every CASS package the control plane imports, installed rather than put on
# the path: they carry their own dependencies and a missing one should fail
# here, at build time, rather than at the first request that touches it.
#
# The keys service and the converter are libraries to the control plane as well
# as services in their own right. The API resolves keys inline and reads model
# packages inline, so both are needed here even though each also has its own
# image.
#
# The converter is installed with its hdf5 extra, because the worker reads
# OpenQuake datastores directly (section 7) and that needs h5py and numpy. The
# API and the worker share this image, so both carry it.
COPY backend/packages ./packages
COPY backend/services ./services
RUN pip install --no-cache-dir \
    ./packages/cass_core \
    ./packages/cass_oed \
    ./packages/cass_extract \
    ./services/keys \
    "./services/converter[hdf5]"

COPY backend/cass_api ./cass_api
COPY backend/adapters ./adapters

# The official PiWind exposure, which section 12 makes the end-to-end
# regression baseline. Small, and needed by seed_demo on a clean install.
COPY tests/fixtures ./tests/fixtures

# Run as a non-root user. Section 10 requires least privilege, and a container
# that writes portfolio data has no reason to be root.
#
# /oasis-model is created here, owned by cass, so a fresh named volume mounted
# there copies up that ownership. Without it Docker creates the mount point as
# root and the worker cannot write the model package it was asked to build.
RUN useradd --create-home --uid 10001 cass \
    && chown -R cass:cass /app \
    && mkdir -p /oasis-model \
    && chown cass:cass /oasis-model
USER cass

WORKDIR /app/cass_api
ENV PYTHONPATH=/app/cass_api:/app/adapters

# Prove the application imports, at build time.
#
# This exists because it did not. The image installed cass_core and cass_oed
# while the control plane had grown to import cass_extract, cass_keys and
# cass_converter as well, and every layer built cleanly: nothing in a build
# imports Django's URLconf, so the first request found out instead. CI builds
# these images on every change and reported success throughout.
#
# `check` loads the settings, the app registry and every URL pattern, and needs
# no database to do it -- so a missing dependency, a broken import or an
# unresolvable route fails here rather than at the first request. The settings
# are told nothing about infrastructure beyond a throwaway key, which keeps
# this a check on the code rather than on the environment.
RUN DJANGO_SETTINGS_MODULE=cass.settings \
    CASS_SECRET_KEY=build-time-check \
    CASS_DEBUG=false \
    python manage.py check --fail-level WARNING

EXPOSE 8000

# gunicorn rather than runserver, in every environment. A development-only
# server in one environment and a production one in another is a difference
# that hides bugs until late.
#
# The API applies migrations before it serves, so a rebuilt stack never runs new
# code against an old schema. It is the only process that does: the worker and
# the scheduler run this image with their own command, and wait for the API to
# be healthy -- which it cannot be until gunicorn is up, after migrate has
# finished -- so nothing reads the schema while it is changing. A failed
# migration stops the container rather than serving against a half-applied one.
# exec hands PID 1 to gunicorn, so a stop signal reaches it rather than sh.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn cass.wsgi:application --bind 0.0.0.0:8000 --workers 3 --timeout 120 --access-logfile - --error-logfile -"]
