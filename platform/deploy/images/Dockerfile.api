# The CASS control plane and its workers.
#
# The API and the worker share one image: they run the same code and the same
# migrations, and a version skew between them would be a source of exactly the
# lineage problems section 5 is written to prevent.

FROM python:3.11.11-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# libpq for psycopg; curl for the healthcheck and support bundle.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies are installed before the source is copied, so a code change
# does not invalidate the dependency layer.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/packages ./packages
RUN pip install --no-cache-dir ./packages/cass_core ./packages/cass_oed

COPY backend/cass_api ./cass_api
COPY backend/adapters ./adapters

# The official PiWind exposure, which section 12 makes the end-to-end
# regression baseline. Small, and needed by seed_demo on a clean install.
COPY tests/fixtures ./tests/fixtures

# Run as a non-root user. Section 10 requires least privilege, and a container
# that writes portfolio data has no reason to be root.
RUN useradd --create-home --uid 10001 cass \
    && chown -R cass:cass /app
USER cass

WORKDIR /app/cass_api
ENV PYTHONPATH=/app/cass_api:/app/adapters

EXPOSE 8000

# gunicorn rather than runserver, in every environment. A development-only
# server in one environment and a production one in another is a difference
# that hides bugs until late.
CMD ["gunicorn", "cass.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
