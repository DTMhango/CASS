# Serves the built interface and proxies the CASS API.
#
# The browser reaches one origin. That keeps the session cookie first-party and
# means the boundary rule of section 4 -- the interface calls only the CASS API --
# holds in the deployed topology as well as in the code.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # nginx discards every inherited add_header in any location that declares
    # one of its own, so the security headers are repeated in each location
    # rather than set once on the server. Setting them once here looks correct
    # and silently produces responses without them.
    #
    # Portfolio and model data are confidential, so these are not optional.

    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        # Asset filenames are content-hashed, so they can be cached hard.
        add_header Cache-Control "public, immutable" always;
        expires 1y;
    }

    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        # index.html must not be cached, or an upgraded installation would keep
        # serving the previous application against the new API.
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location /api/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;

        proxy_pass ${CASS_API_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Correlation IDs follow a run across services (section 4).
        proxy_set_header X-Correlation-ID $request_id;

        # Exposure files can be large, and a long analysis submission should
        # not be cut off by a proxy timeout.
        client_max_body_size 512m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /health/ {
        proxy_pass ${CASS_API_ORIGIN};
        access_log off;
    }

    # The interface is a single-page application: unknown paths are routes,
    # not missing files.
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
